{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": ["DOM", "ES2022"],
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true
  },
  "include": ["app", ".react-router/types/**/*.d.ts"],
  "exclude": ["test"]
}
