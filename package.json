{
  "name": "cf-simple-mail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf build && react-router build && test ! -e build/client/index.html && test ! -e build/client/app.js",
    "dev": "react-router dev",
    "deploy": "bun run build && wrangler deploy --config build/server/wrangler.json",
    "hash-password": "bun scripts/hash-password.ts",
    "test": "bun test",
    "typecheck": "react-router typegen && tsc -b",
    "check": "bun run typecheck"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "dompurify": "^3.2.6",
    "lucide-react": "^1.47.0",
    "postal-mime": "^2.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "7.18.3",
    "ulid": "^3.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "^4.20250920.0",
    "@react-router/dev": "7.18.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.2",
    "typescript": "^5.9.2",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "5.1.4",
    "wrangler": "^4.34.0"
  }
