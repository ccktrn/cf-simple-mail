{
  "name": "cf-simple-mail",
  "main": "app/index.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "kv_namespaces": [{ "binding": "MAIL_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "vars": {
    "MAIL_PROVIDER": "resend",
    "MAIL_FROM_ADDRESSES": "[\"recovery@example.com\", \"support@example.com\"]",
    "MAIL_TTL_SECONDS": "604800",
    "SESSION_TTL_SECONDS": "1800"
  }
}
